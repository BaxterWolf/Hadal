// Icons + version info
#include <winver.h>

1 ICON "hadal-on.ico"
2 ICON "hadal-on.ico"
3 ICON "hadal-paused.ico"
4 ICON "hadal-off.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION HADAL_V1, HADAL_V2, HADAL_V3, 0
PRODUCTVERSION HADAL_V1, HADAL_V2, HADAL_V3, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
#ifdef HADAL_SVC
            VALUE "FileDescription", "Hadal service (phone remote control over Tailscale)"
            VALUE "OriginalFilename", "hadal-svc.exe"
#else
            VALUE "FileDescription", "Hadal tray (phone remote control over Tailscale)"
            VALUE "OriginalFilename", "hadal-tray.exe"
#endif
            VALUE "ProductName", "Hadal"
            VALUE "FileVersion", HADAL_VSTR
            VALUE "ProductVersion", HADAL_VSTR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
